name "gmail-read-inbox"
bin "gmail-read-inbox"
about "Fetch Gmail into the payload tracker.py collect consumes."
version "1.0.0"

flag "--label <label>" help="Fetch only this label (validated against Gmail labels)"
flag "--since <date>" help="Lookback start date, YYYY-MM-DD"
flag "--max <max>" help="Total messages to collect, fetched 50 at a time"
flag "--inbox <file>" help="Inbox payload path"
flag "--labels-out <file>" help="Complete Gmail label inventory path"
flag "--job-labels-out <file>" help="Cached JOB-label hierarchy path"
flag "--timeout <timeout>" help="Timeout in seconds per Composio API call (default: 60)"
flag "-v --verbose" help="Print detailed progress and timing to stderr"
flag "--dry-run" help="Read Gmail and compare labels, but write nothing"
