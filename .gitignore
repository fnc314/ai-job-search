*.pyc
*.pyo
.venv/
venv/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Personal data (never commit these)
salary_data.json
*_BehavioralReport.pdf
linkedin_Profile.pdf

# Personal photos and signatures
*.jpg
*.jpeg
*.png
!templates/cover-letters/OpenFonts/fonts/**

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json

# Personal application output files (generated by /apply — do not share)
# Extension-agnostic on the ignore side: a custom template registered via
# /add-template (e.g. Typst) writes main_<company>_<role>.typ instead of
# .tex, and it must be ignored just as reliably as the stock LaTeX output.
# The negations stay .tex-only - the stock example files are always LaTeX,
# and a wildcard negation (!cv/main_example.*) would also re-include build
# artifacts like main_example.pdf/.aux.
templates/cv/main_*.*
!templates/cv/main_example.tex
templates/cv/*.txt
templates/cover-letters/cover_*.*
templates/cover-letters/Cover_*.*
!templates/cover-letters/cover_example.tex

# job-applications/ subfolder contents are personal — only README and folder structure are tracked
job-applications/**

# Frozen pre-migration snapshot (see archive/README.md). Never a data source.
archive/*.csv

# Service-account credentials for the tracker store (scripts/tracker.py).
# These grant read/write to the only authoritative copy of the application
# record, so a committed key is a full data breach. The canonical location is
# ~/.config/job-tracker/sa.json; these patterns exist to stop a stray copy.
sa.json
**/sa.json
**/*serviceAccount*.json
**/service-account*.json

# Local offline read cache (regenerable from Firestore, never authoritative)
generated/tracker-cache.json

# Firebase CLI and emulator artifacts (firestore-debug.log is already covered by *.log)
.firebase/
firestore-debug.log
ui-debug.log

# TUI runtime logs (also covered by *.log, but explicit for clarity)
.logs/

# Gmail sync state (message IDs, subjects - personal data)
gmail-sync/

# Generated reports (personal output from /html-report)
reports/

# Upskill reports (personal output)
upskill/*.md

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Brainstorm mockups (superpowers visual companion) - never ship
.superpowers/
*.zip

# Environment & Secrets (NEVER leak private keys, tokens, or local credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
secrets/

# Assistant & Agent runner local state, plugins, and caches. The one exception
# per directory is its instruction pointer, which belongs in git so the
# "read from .agents/" rule travels with the repo.
.gemini/*
!.gemini/GEMINI.md
.qwen/*
!.qwen/QWEN.md
.composio/
.recalc_queue
plugins/
generated/

# Scraped postings, intermediate HTML, text, and JSON debug dumps
job*.html
job*.txt
openai_job.*
detail_*.json
p1_*.json
fh_*.json
li_*.json
*_detail*.txt
*_detail_wrapped.txt
*_job_posting.txt
google_job_posting.txt
tekgence_detail.txt

# Job scraper state (seen jobs, notion sync, etc.)
# Match at any depth: the job-scraper skill resolves `job-scraper/` relative to
# its own directory, so these land at .claude/skills/job-scraper/job-scraper/*.
**/job-scraper/seen_jobs.json
**/job-scraper/notion_sync.json
**/job-scraper/*.md

# Scratch, ad-hoc, and local helper scripts containing personal paths/data
cross_reference.py
fetch_disney.py
fetch_resume.py
fix_cv_layout.py
fix_final.py
fix_relocation.py
generate_samples.py
organize_docs.py
parse_html.py
parse_html_stdin.py
standardize_apps.py

# Personal LaTeX samples: track .tex sources, ignore only compiled artifacts.
# (The .tex files are upstream reference templates; .pdf/.aux/.log are build output.)
cover_*.log

# Personal candidate outreach & profile disclosures (populated by /setup)
.claude/skills/job-application-assistant/01-candidate-profile.md
.claude/skills/job-application-assistant/02-behavioral-profile.md
.claude/skills/job-application-assistant/04-job-evaluation.md
.claude/skills/job-application-assistant/07-interview-prep.md
.claude/skills/job-scraper/search-queries.md

bin
