    "scrapedPosting": {
      "type": "object",
      "description": "One scraped job posting. Document ID equals `uuid` (UUIDv7). Deduped by `normalizedUrl` or `dedupKey` (companySlug-titleSlug). Re-scraped postings increment `scrapeCount` and update `lastScrapedAt`.",
      "additionalProperties": false,
      "required": [
        "uuid",
        "dedupKey",
        "normalizedUrl",
        "companySlug",
        "titleSlug",
        "title",
        "company",
        "url",
        "portal",
        "firstScrapedAt",
        "lastScrapedAt",
        "scrapeCount",
        "fitStatus",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuidV7"
        },
        "dedupKey": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Composite key: \"<companySlug>-<titleSlug>\" for cross-portal dedup."
        },
        "normalizedUrl": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "URL without query/fragment, lowercased, for exact URL dedup."
        },
        "companySlug": {
          "$ref": "#/$defs/slug"
        },
        "titleSlug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "company": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nullableString"
        },
        "portal": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Source portal identifier, e.g. \"linkedin-search\", \"freehire-search\"."
        },
        "searchQuery": {
          "$ref": "#/$defs/nullableString",
          "description": "Which search query matched this posting."
        },
        "postingDate": {
          "$ref": "#/$defs/nullableString",
          "description": "ISO date from the job listing, if available."
        },
        "applicationDeadline": {
          "$ref": "#/$defs/nullableString",
          "description": "ISO date from the job listing."
        },
        "jobId": {
          "$ref": "#/$defs/nullableString",
          "description": "Portal-specific ID, e.g. reqId."
        },
        "description": {
          "$ref": "#/$defs/nullableString",
          "description": "Snippet from detail fetch."
        },
        "keyRequirements": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "firstScrapedAt": {
          "$ref": "#/$defs/isoTimestamp"
        },
        "lastScrapedAt": {
          "$ref": "#/$defs/isoTimestamp"
        },
        "scrapeCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Starts at 1, incremented on re-scrape."
        },
        "fitRating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "fitStatus": {
