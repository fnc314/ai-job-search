    "event": {
      "type": "object",
      "description": "Append-only. Correct a mistake by emitting a new event, never by editing or deleting an existing one.",
      "additionalProperties": false,
      "required": [
        "eventId",
        "ts",
        "date",
        "type",
        "actor",
        "derivedFrom",
        "confidence"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/uuidV7",
          "description": "UUIDv7: lexicographically sortable by creation time, so the log needs no secondary index to order chronologically."
        },
        "ts": {
          "$ref": "#/$defs/isoTimestamp"
        },
        "date": {
