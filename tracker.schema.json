      ]
    },
    "syncStateValue": {
      "type": "string",
      "enum": [
        "PENDING",
        "CLAIMED",
        "DONE",
        "FAILED"
      ]
    },
    "scrapedPostingStatusValue": {
      "type": "string",
      "description": "Lifecycle of a scraped posting record. Values match proto enum names (NEW, REVIEWED, REJECTED, APPLIED) stored directly in Firestore.",
      "enum": [
        "NEW",
        "REVIEWED",
        "REJECTED",
        "APPLIED"
      ]
