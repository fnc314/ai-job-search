        },
        "contactPerson": {
          "$ref": "#/$defs/nullableString"
        },
        "contactEmail": {
          "$ref": "#/$defs/nullableString"
        },
        "jobUrl": {
          "$ref": "#/$defs/nullableString"
        },
        "jobApplicationUrl": {
          "$ref": "#/$defs/nullableString"
        },
        "emailMessageIds": {
          "type": "array",
