        "FIT_STRETCH",
        "FIT_GAP_IOS",
        "FIT_GAP_CROSS_PLATFORM",
        "PROCESS_TAKE_HOME",
        "PROCESS_REFERRAL",
        "PROCESS_INTERNAL_CONTACT",
        "PROCESS_NO_RESPONSE_30D",
        "PROCESS_RECRUITER_OUTREACH"
      ]
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "year",
            "month",
            "hour",
            null
          ]
        },
        "bandSource": {
          "$ref": "#/$defs/nullableString"
        },
        "vsTarget": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "below",
            "at",
            "above",
            null
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": {
          "$ref": "#/$defs/nullableString"
        },
        "region": {
          "$ref": "#/$defs/nullableString"
        },
        "country": {
          "$ref": "#/$defs/nullableString"
        },
        "relocation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "superCommuter": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "roleLocation": {
          "$ref": "#/$defs/roleLocationValue"
        }
      }
    },
    "fitEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rubricVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evaluatedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "logoFormat": {
      "type": "string",
      "enum": [
        "AVIF",
        "WEBP",
        "PNG",
        "SVG",
        "UNKNOWN"
      ]
    },
    "logoShape": {
      "type": "string",
      "enum": [
        "SQUARE",
        "RECTANGLE",
        "UNKNOWN"
      ]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "followUpsSent": {
          "type": "integer",
          "minimum": 0
        },
        "interviews": {
          "type": "integer",
          "minimum": 0
        },
        "rejections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstActivityAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastActivityAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "daysSinceActivity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "nextFollowUpAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "submittedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "submissionConfirmedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "application": {
      "type": "object",
      "description": "One tracked application. Document ID equals `id`. Unknown top-level keys are rejected: adding a field is an explicit schemaVersion bump.",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "company",
        "companyId",
        "status",
        "schemaVersion",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/documentId"
        },
        "date": {
          "$ref": "#/$defs/isoTimestamp"
        },
        "company": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "companyId": {
          "$ref": "#/$defs/slug"
        },
        "sector": {
          "$ref": "#/$defs/nullableString"
        },
        "role": {
          "$ref": "#/$defs/nullableString"
        },
        "roleType": {
          "$ref": "#/$defs/nullableString"
        },
        "channel": {
          "oneOf": [
            {
