        "US_NYC",
        "US_SF",
        "US_LA",
        "US_DC",
        "US_REMOTE"
      ]
    },
    "tagValue": {
      "type": "string",
      "description": "Controlled vocabulary. Adding a tag is a schemaVersion bump, deliberately.",
      "enum": [
        "RELOCATION_REQUIRED",
        "RELOCATION_ACCEPTED",
        "RELOCATION_DECLINED",
        "COMPENSATION_ABOVE_SUPER_COMMUTER_NYC",
        "COMPENSATION_ABOVE_SUPER_COMMUTER_SF",
        "COMPENSATION_BELOW_NYC_FLOOR",
        "COMPENSATION_BELOW_BAND",
        "COMPENSATION_AT_BAND",
