# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.
#
# mise loads .env.local via `[env] _.file` in mise.toml.

# Required by the portal-search CLIs (Composio).
COMPOSIO_API_KEY=

# Required for Google Workspace/Sheets/Drive lookups.
GOOGLE_API_KEY=

# The GCP project and GCS bucket that hold the canonical tracker record.
# Defaults match the maintainer's project; set both explicitly in a fork.
TRACKER_PROJECT=
TRACKER_BUCKET=

# Opts in to writing the tracker record. Without it, every write subcommand of
# scripts/tracker.py refuses to run. Set to 1 deliberately; do not leave it on
# in a shared or CI environment.
TRACKER_ALLOW_WRITES=

# Path to the service-account key (default: ~/.config/job-tracker/sa.json).
# TRACKER_SA_KEY=

# The spreadsheet the generated view is written to. Create it, share it with
# the service account as Editor, then paste its id here.
TRACKER_SHEET_ID=

# ==============================================================================
# Remote Cloud Run & Scheduler Settings (Optional / Remote Offload)
# ==============================================================================
# The GCP Project and Region for Cloud Run & Cloud Scheduler. Defaults to TRACKER_PROJECT.
REMOTE_GCP_PROJECT=
REMOTE_GCP_REGION=us-east1

# Cadence for automated routine sweeps. Default: 4x/day ("0 */6 * * *").
REMOTE_SWEEP_CRON="0 */6 * * *"

# Sizing and scaling limits to guarantee $0 always-free tier operation.
REMOTE_MIN_INSTANCES=0
REMOTE_MAX_INSTANCES=1
REMOTE_MEMORY=512Mi
REMOTE_CPU=1

# Container build mode: "local" (uses local Docker daemon) or "cloud" (uses Cloud Build).
REMOTE_BUILD_MODE=local

# Company Metadata Enrichment - https://hunter.io - Source of logos
HUNTER_IO_API_KEY=
